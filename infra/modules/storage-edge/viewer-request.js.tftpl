function querySuffix(querystring) {
  var parts = [];
  var keys = Object.keys(querystring || {});
  for (var index = 0; index < keys.length; index += 1) {
    var key = keys[index];
    var entry = querystring[key];
    var values = entry.multiValue || [entry];
    for (var valueIndex = 0; valueIndex < values.length; valueIndex += 1) {
      parts.push(
        encodeURIComponent(key) + "=" + encodeURIComponent(values[valueIndex].value),
      );
    }
  }
  return parts.length === 0 ? "" : "?" + parts.join("&");
}

function handler(event) {
  var request = event.request;
  var canonicalHost = ${canonical_host_json};
  var viewerHost = request.headers.host.value.toLowerCase();
  var isApi = request.uri === "/api" || request.uri.indexOf("/api/") === 0;

  if (canonicalHost && viewerHost !== canonicalHost.toLowerCase()) {
    if (isApi) {
      return {
        statusCode: 409,
        statusDescription: "Conflict",
        headers: {
          "cache-control": { value: "no-store" },
          "content-type": { value: "application/json; charset=utf-8" },
        },
        body: JSON.stringify({
          error:
            "This site has moved. Reload the page at https://" +
            canonicalHost +
            " and try again.",
        }),
      };
    }
    return {
      statusCode: 308,
      statusDescription: "Permanent Redirect",
      headers: {
        "cache-control": { value: "no-store" },
        location: {
          value:
            "https://" +
            canonicalHost +
            request.uri +
            querySuffix(request.querystring),
        },
      },
    };
  }

  if (
    !isApi &&
    (request.method === "GET" || request.method === "HEAD") &&
    request.uri.split("/").pop().indexOf(".") === -1
  ) {
    request.uri = "/index.html";
  }
  return request;
}
